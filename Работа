def print_fast(text):
    """Принудительный вывод текста на экран (flush=True) для обхода багов PyCharm."""
    print(text, flush=True)


def show_game_status():
    """Отображение состояния коллекций (списка инвентаря и множества флагов)."""
    print_fast("\n" + "=" * 60)
    print_fast(f"👤 ТЕКУЩИЙ АККАУНТ: {ACCOUNT_DATA}")
    print_fast(f"🎒 ИНВЕНТАРЬ (Список): {inventory}")
    print_fast(f"🔑 СОБРАННЫЕ УЛИКИ (Множество): {list(security_flags) if security_flags else 'Улик пока нет'}")
    print_fast("=" * 60 + "\n")


def check_global_cmd(user_input):
    """Проверка сервисных команд игрока."""
    cmd = user_input.strip().lower()
    if cmd == "status":
        show_game_status()
        return True
    elif cmd == "inspect":
        print_fast(f"\nВаш инвентарь: {inventory}")
        choice = input("Какой предмет изучить? Введите название: ").strip().lower()
        if choice in inventory:
            desc = CYBER_CONTEXT["описание_предметов"].get(choice, "Описание отсутствует.")
            print_fast(f"\n🔎 [РЕЗУЛЬТАТ ИНСПЕКЦИИ]: {desc}\n")
        else:
            print_fast("\n❌ Ошибка: Такого предмета нет в инвентаре.\n")
        return True
    return False


