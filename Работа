    # Шаг 1.1: Первая улика
    step1_done = False
    while not step1_done:
        print_fast("\n[ДЕЙСТВИЕ 1]: С чего вы начнете расследование?")
        print_fast(" А) Проверить почтовые логи и найти подозрительное фишинговое письмо директора.")
        print_fast(" Б) Игнорировать оповещение и пойти пить кофе.")

        choice = input("Ваш выбор (А или Б): ").strip().upper()
        if check_global_cmd(choice):
            continue

        if choice in ("А", "A"):
            print_fast("\n✅ [УСПЕХ]: Вы открыли почтовый сервер!")
            print_fast("Найдено поддельное письмо с темой 'Срочный отчет'. Это атака класса Phishing.")
            inventory.append("фишинговое_письмо")
            security_flags.add("письмо_изучено")
            print_fast("👉 Предмет 'фишинговое_письмо' добавлен в ваш инвентарь (список).")
            step1_done = True
        elif choice in ("Б", "B"):
            print_fast("\n❌ [ОШИБКА]: Хакеры продолжают скачивать файлы! Выберите вариант А.")
        else:
            print_fast("\n[!] Неизвестная команда. Введите букву А или Б.")

    # Шаг 1.2: Вторая улика
    step2_done = False
    while not step2_done:
        print_fast("\n[ДЕЙСТВИЕ 2]: Письмо локализовано. Как определить, куда хакер сливает данные?")
        print_fast(" А) Запустить утилиту Wireshark и перехватить дамп сетевого трафика (pcap).")
        print_fast(" Б) Попытаться угадать IP-адрес злоумышленника наугад.")

        choice = input("Ваш выбор (А или Б): ").strip().upper()
        if check_global_cmd(choice):
            continue

        if choice in ("А", "A"):
            print_fast("\n✅ [УСПЕХ]: Сетевые пакеты перехвачены!")
            print_fast("Вы видите активную сессию с сервером злоумышленника. Дамп pcap сохранен.")
            inventory.append("дамп_трафика")
            security_flags.add("трафик_проанализирован")
            print_fast("👉 Предмет 'дамп_трафика' добавлен в ваш инвентарь.")
            step2_done = True
        elif choice in ("Б", "B"):
            print_fast("\n❌ [ОШИБКА]: В сети миллионы адресов, угадать невозможно. Используйте Wireshark (Вариант А).")
        else:
            print_fast("\n[!] Неизвестная команда. Введите букву А или Б.")

    # Секретный подэтап: извлечение ключа администратора
    print_fast("\n[АНАЛИЗ]: Вы объединили собранные улики вместе.")
    print_fast("Просматривая 'дамп_трафика', вы заметили критическую ошибку самого хакера:")
    print_fast("В одном из пакетов он случайно оставил скомпрометированный цифровой Root-ключ!")
    inventory.append("ключ_администратора")
    security_flags.add("ключ_получен")
    print_fast("⚠️ [ВНИМАНИЕ]: Вы получили 'ключ_администратора'! Он необходим для доступа к серверам.")

    print_fast("\n🎉 СУПЕР! Уровень 1 завершен. Все улики собраны. Множество флагов заполнено.")
    print_fast("Переходим к ликвидации угрозы на сервере компании.")


